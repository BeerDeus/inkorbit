{
  "id": "./",
  "name": "Ink Orbit",
  "short_name": "Ink Orbit",
  "description": "Ta collection de cartes Lorcana, tes decks et leur valeur. Appli de fan gratuite et non officielle.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#120d2e",
  "theme_color": "#140f2e",
  "categories": ["games", "entertainment", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "screenshots/phone-home.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Ta collection et sa valeur" },
    { "src": "screenshots/phone-lore.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Le compteur de lore, face à face" },
    { "src": "screenshots/desktop-home.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Ink Orbit sur ordinateur" }
  ],
  "shortcuts": [
    { "name": "Scanner", "short_name": "Scanner", "description": "Ajouter des cartes avec l'appareil photo", "url": "./?open=scan", "icons": [{ "src": "icons/sc-scan.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Ajouter des cartes", "short_name": "Ajouter", "description": "Ajouter des cartes une par une", "url": "./?open=add", "icons": [{ "src": "icons/sc-add.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Échange", "short_name": "Échange", "description": "Tes doublons et les cartes que tu cherches", "url": "./?open=trade", "icons": [{ "src": "icons/sc-trade.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Compteur de lore", "short_name": "Lore", "description": "Compter le lore d'une partie", "url": "./?open=lore", "icons": [{ "src": "icons/sc-lore.png", "sizes": "96x96", "type": "image/png" }] }
  ],
  "share_target": { "action": "./", "method": "GET", "params": { "title": "title", "text": "text", "url": "url" } },
  "file_handlers": [{ "action": "./?open=import", "accept": { "text/csv": [".csv"], "text/plain": [".txt"] }, "launch_type": "single-client" }]
}
