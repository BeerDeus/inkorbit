# Ink Orbit sur Hostinger (LiteSpeed / Apache) : HTTPS, types de fichiers, cache.
# La page, le service worker, le manifeste et les données (prix du jour) sont toujours revérifiés : une nouvelle version arrive tout de suite.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
DirectoryIndex index.html
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
